{
  "name": "console-codemirror-bundle",
  "private": true,
  "type": "module",
  "description": "Builds claude_discord/console/static/vendor-codemirror.min.js. Not used at runtime.",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --target=es2020 --legal-comments=none --alias:@codemirror/lang-html=./html-stub.js --outfile=../../claude_discord/console/static/vendor-codemirror.min.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
